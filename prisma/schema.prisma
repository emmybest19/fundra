// Fundra database schema. Design and rationale: docs/DATABASE.md.
// The connection URL lives in prisma.config.ts (Prisma 7), not here.
//
// Conventions: UUIDv7 keys generated by PostgreSQL 18, snake_case tables/columns,
// money as BigInt kobo next to a char(3) currency, timestamptz(3) timestamps.
// CHECK constraints can't be expressed here; they are hand-written in the migrations.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  // Node runs our TypeScript directly, so generated imports must use .ts (see README, Scripts).
  importFileExtension = "ts"
  previewFeatures     = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DEACTIVATED

  @@map("user_status")
}

enum KycStatus {
  NOT_STARTED
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED

  @@map("kyc_status")
}

enum KycDocumentType {
  NATIONAL_ID
  PASSPORT
  DRIVERS_LICENSE
  VOTERS_CARD
  UTILITY_BILL
  SELFIE

  @@map("kyc_document_type")
}

enum KycDocumentStatus {
  PENDING
  ACCEPTED
  REJECTED

  @@map("kyc_document_status")
}

enum LedgerAccountType {
  ASSET
  LIABILITY
  REVENUE
  EXPENSE

  @@map("ledger_account_type")
}

enum WalletStatus {
  ACTIVE
  FROZEN
  CLOSED

  @@map("wallet_status")
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER
  PAYMENT
  REFUND
  FEE
  REVERSAL

  @@map("transaction_type")
}

enum TransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REVERSED
  CANCELLED

  @@map("transaction_status")
}

enum EntryDirection {
  DEBIT
  CREDIT

  @@map("entry_direction")
}

enum HoldStatus {
  ACTIVE
  SETTLED
  RELEASED

  @@map("hold_status")
}

enum RecipientLookupType {
  HANDLE
  ACCOUNT_NUMBER

  @@map("recipient_lookup_type")
}

enum PaymentDirection {
  INBOUND
  OUTBOUND

  @@map("payment_direction")
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
  IGNORED

  @@map("webhook_status")
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED

  @@map("idempotency_status")
}

enum BeneficiaryType {
  FUNDRA_WALLET
  BANK_ACCOUNT

  @@map("beneficiary_type")
}

enum NotificationChannel {
  EMAIL
  SMS
  PUSH
  IN_APP

  @@map("notification_channel")
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED

  @@map("notification_status")
}

enum ActorType {
  USER
  ADMIN
  SYSTEM

  @@map("actor_type")
}

// ─── Identity & access ───────────────────────────────────────────────────────

model User {
  id                String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Lower-case (CHECK).
  email             String     @unique
  emailVerifiedAt   DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  /// E.164 (CHECK).
  phone             String     @unique
  phoneVerifiedAt   DateTime?  @map("phone_verified_at") @db.Timestamptz(3)
  /// Public @handle, lower-case [a-z0-9_]{3,20} (CHECK).
  handle            String     @unique
  firstName         String     @map("first_name")
  lastName          String     @map("last_name")
  /// Argon2id encoded hash.
  passwordHash      String     @map("password_hash")
  passwordChangedAt DateTime   @default(now()) @map("password_changed_at") @db.Timestamptz(3)
  status            UserStatus @default(PENDING_VERIFICATION)
  failedLoginCount  Int        @default(0) @map("failed_login_count")
  lockedUntil       DateTime?  @map("locked_until") @db.Timestamptz(3)
  preferences       Json       @default("{}")
  deactivatedAt     DateTime?  @map("deactivated_at") @db.Timestamptz(3)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  roles           UserRole[]       @relation("UserRoles")
  rolesGranted    UserRole[]       @relation("UserRoleGrants")
  sessions        Session[]
  kycProfile      KycProfile?      @relation("KycProfileOwner")
  kycReviews      KycProfile[]     @relation("KycProfileReviewer")
  wallets         Wallet[]
  initiatedTxns   Transaction[]
  idempotencyKeys IdempotencyKey[]
  beneficiaries   Beneficiary[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  settingsUpdated SystemSetting[]

  @@map("users")
}

model Role {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// SUPER_ADMIN, ADMIN, SUPPORT, COMPLIANCE, FINANCE, USER (seeded).
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// resource:action, e.g. kyc:review (CHECK).
  key         String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId          String   @map("user_id") @db.Uuid
  roleId          String   @map("role_id") @db.Uuid
  grantedByUserId String?  @map("granted_by_user_id") @db.Uuid
  grantedAt       DateTime @default(now()) @map("granted_at") @db.Timestamptz(3)

  user      User  @relation("UserRoles", fields: [userId], references: [id], onDelete: Restrict)
  role      Role  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  grantedBy User? @relation("UserRoleGrants", fields: [grantedByUserId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model Session {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  deviceId     String?   @map("device_id")
  deviceName   String?   @map("device_name")
  userAgent    String?   @map("user_agent")
  ipAddress    String?   @map("ip_address") @db.Inet
  lastUsedAt   DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  /// LOGOUT, TOKEN_REUSE, PASSWORD_CHANGED, ADMIN
  revokeReason String?   @map("revoke_reason")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  refreshTokens RefreshToken[]

  @@index([userId], map: "sessions_user_id_active_idx", where: raw("revoked_at IS NULL"))
  @@map("sessions")
}

model RefreshToken {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// The session is the token family.
  sessionId    String    @map("session_id") @db.Uuid
  /// SHA-256 hex of the opaque token; the token itself is never stored.
  tokenHash    String    @unique @map("token_hash") @db.Char(64)
  replacedById String?   @unique @map("replaced_by_id") @db.Uuid
  usedAt       DateTime? @map("used_at") @db.Timestamptz(3)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  session    Session       @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  replacedBy RefreshToken? @relation("TokenRotation", fields: [replacedById], references: [id], onDelete: Restrict)
  replaces   RefreshToken? @relation("TokenRotation")

  @@index([sessionId])
  @@map("refresh_tokens")
}

// ─── KYC ─────────────────────────────────────────────────────────────────────

model KycProfile {
  id                String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId            String    @unique @map("user_id") @db.Uuid
  /// Approved tier 0–3 (CHECK). 0 = not verified, no wallet.
  tier              Int       @default(0) @db.SmallInt
  status            KycStatus @default(NOT_STARTED)
  requestedTier     Int?      @map("requested_tier") @db.SmallInt
  dateOfBirth       DateTime? @map("date_of_birth") @db.Date
  addressLine1      String?   @map("address_line1")
  addressLine2      String?   @map("address_line2")
  city              String?
  state             String?
  /// ISO 3166-1 alpha-2.
  country           String?   @db.Char(2)
  postalCode        String?   @map("postal_code")
  /// AES-256-GCM ciphertext.
  bvnEncrypted      Bytes?    @map("bvn_encrypted")
  ninEncrypted      Bytes?    @map("nin_encrypted")
  /// HMAC-SHA-256: uniqueness without storing the number.
  bvnHmac           String?   @unique @map("bvn_hmac") @db.Char(64)
  ninHmac           String?   @unique @map("nin_hmac") @db.Char(64)
  provider          String?
  providerReference String?   @map("provider_reference")
  submittedAt       DateTime? @map("submitted_at") @db.Timestamptz(3)
  reviewedAt        DateTime? @map("reviewed_at") @db.Timestamptz(3)
  reviewedByUserId  String?   @map("reviewed_by_user_id") @db.Uuid
  rejectionReason   String?   @map("rejection_reason")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user       User          @relation("KycProfileOwner", fields: [userId], references: [id], onDelete: Restrict)
  reviewedBy User?         @relation("KycProfileReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)
  documents  KycDocument[]

  @@map("kyc_profiles")
}

model KycDocument {
  id           String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  kycProfileId String            @map("kyc_profile_id") @db.Uuid
  type         KycDocumentType
  /// Object-storage key. Never a public URL.
  storageKey   String            @unique @map("storage_key")
  mimeType     String            @map("mime_type")
  sizeBytes    Int               @map("size_bytes")
  sha256       String            @db.Char(64)
  status       KycDocumentStatus @default(PENDING)
  uploadedAt   DateTime          @default(now()) @map("uploaded_at") @db.Timestamptz(3)
  reviewedAt   DateTime?         @map("reviewed_at") @db.Timestamptz(3)

  kycProfile KycProfile @relation(fields: [kycProfileId], references: [id], onDelete: Restrict)

  @@index([kycProfileId])
  @@map("kyc_documents")
}

model TierLimit {
  tier                Int      @db.SmallInt
  currency            String   @db.Char(3)
  perTransactionLimit BigInt   @map("per_transaction_limit")
  /// Per Africa/Lagos calendar day.
  dailyOutflowLimit   BigInt   @map("daily_outflow_limit")
  /// NULL = unlimited.
  maxBalance          BigInt?  @map("max_balance")
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([tier, currency])
  @@map("tier_limits")
}

// ─── Money ───────────────────────────────────────────────────────────────────

model LedgerAccount {
  id        String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// WALLET:<id>, PROVIDER_SETTLEMENT:<PROVIDER>:<CCY>, FEE_REVENUE:<CCY>, SUSPENSE:<CCY>
  code      String            @unique
  type      LedgerAccountType
  currency  String            @db.Char(3)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  /// At most one (wallets.ledger_account_id is unique).
  wallets Wallet[]
  entries LedgerEntry[]

  // Target of composite foreign keys that keep currencies consistent.
  @@unique([id, currency])
  @@map("ledger_accounts")
}

model Wallet {
  id               String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId           String       @map("user_id") @db.Uuid
  currency         String       @db.Char(3)
  /// 10 digits with a check digit (CHECK).
  accountNumber    String       @unique @map("account_number") @db.Char(10)
  ledgerAccountId  String       @unique @map("ledger_account_id") @db.Uuid
  status           WalletStatus @default(ACTIVE)
  /// Cache of posted entries, kobo. Never negative (CHECK).
  ledgerBalance    BigInt       @default(0) @map("ledger_balance")
  /// ledger_balance minus active holds, kobo (CHECK 0 <= available <= ledger).
  availableBalance BigInt       @default(0) @map("available_balance")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user          User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  ledgerAccount LedgerAccount @relation(fields: [ledgerAccountId, currency], references: [id, currency], onDelete: Restrict)
  outgoingTxns  Transaction[] @relation("SourceWallet")
  incomingTxns  Transaction[] @relation("DestinationWallet")
  holds         Hold[]
  beneficiaries Beneficiary[]

  @@unique([userId, currency])
  @@map("wallets")
}

model Transaction {
  id                  String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// FND-TRX-YYYYMMDD-XXXXXX (CHECK).
  reference           String            @unique
  type                TransactionType
  status              TransactionStatus @default(PENDING)
  currency            String            @db.Char(3)
  /// Principal, kobo (> 0).
  amount              BigInt
  /// Fee, kobo (>= 0). The source is debited amount + fee.
  fee                 BigInt            @default(0)
  sourceWalletId      String?           @map("source_wallet_id") @db.Uuid
  destinationWalletId String?           @map("destination_wallet_id") @db.Uuid
  initiatedByUserId   String?           @map("initiated_by_user_id") @db.Uuid
  reversalOfId        String?           @unique @map("reversal_of_id") @db.Uuid
  description         String?           @db.VarChar(140)
  failureReason       String?           @map("failure_reason")
  metadata            Json              @default("{}")
  completedAt         DateTime?         @map("completed_at") @db.Timestamptz(3)
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  sourceWallet      Wallet?          @relation("SourceWallet", fields: [sourceWalletId], references: [id], onDelete: Restrict)
  destinationWallet Wallet?          @relation("DestinationWallet", fields: [destinationWalletId], references: [id], onDelete: Restrict)
  initiatedBy       User?            @relation(fields: [initiatedByUserId], references: [id], onDelete: Restrict)
  reversalOf        Transaction?     @relation("Reversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy        Transaction?     @relation("Reversal")
  entries           LedgerEntry[]
  hold              Hold?
  transfer          Transfer?
  payment           Payment?
  webhookEvents     WebhookEvent[]
  idempotencyKeys   IdempotencyKey[]

  @@unique([id, currency])
  @@index([sourceWalletId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([destinationWalletId, createdAt(sort: Desc), id(sort: Desc)])
  // Written exactly as PostgreSQL stores it (it rewrites `IN (...)` to `= ANY (ARRAY[...])`);
  // otherwise Prisma sees a difference and drops/recreates the index in every migration.
  @@index([status, createdAt], map: "transactions_in_flight_idx", where: raw("status = ANY (ARRAY['PENDING'::transaction_status, 'PROCESSING'::transaction_status])"))
  @@map("transactions")
}

/// Append-only (trigger, Stage 5 item 4). The financial source of truth.
model LedgerEntry {
  id              String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  transactionId   String         @map("transaction_id") @db.Uuid
  ledgerAccountId String         @map("ledger_account_id") @db.Uuid
  direction       EntryDirection
  /// kobo, > 0; direction carries the sign.
  amount          BigInt
  currency        String         @db.Char(3)
  /// Wallet accounts only: ledger balance after this entry.
  balanceAfter    BigInt?        @map("balance_after")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  // Composite keys force the entry's currency to match its transaction and its account.
  transaction   Transaction   @relation(fields: [transactionId, currency], references: [id, currency], onDelete: Restrict)
  ledgerAccount LedgerAccount @relation(fields: [ledgerAccountId, currency], references: [id, currency], onDelete: Restrict)

  @@index([transactionId])
  @@index([ledgerAccountId, createdAt, id])
  @@map("ledger_entries")
}

model Hold {
  id            String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  walletId      String     @map("wallet_id") @db.Uuid
  transactionId String     @unique @map("transaction_id") @db.Uuid
  amount        BigInt
  status        HoldStatus @default(ACTIVE)
  expiresAt     DateTime?  @map("expires_at") @db.Timestamptz(3)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  resolvedAt    DateTime?  @map("resolved_at") @db.Timestamptz(3)

  wallet      Wallet      @relation(fields: [walletId], references: [id], onDelete: Restrict)
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@index([walletId], map: "holds_wallet_id_active_idx", where: raw("status = 'ACTIVE'"))
  @@map("holds")
}

model Transfer {
  transactionId        String              @id @map("transaction_id") @db.Uuid
  recipientLookup      RecipientLookupType @map("recipient_lookup")
  recipientLookupValue String              @map("recipient_lookup_value")
  beneficiaryId        String?             @map("beneficiary_id") @db.Uuid

  transaction Transaction  @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  beneficiary Beneficiary? @relation(fields: [beneficiaryId], references: [id], onDelete: Restrict)

  @@index([beneficiaryId])
  @@map("transfers")
}

model FeeRule {
  id              String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  transactionType TransactionType @map("transaction_type")
  currency        String          @db.Char(3)
  flatFee         BigInt          @default(0) @map("flat_fee")
  /// Basis points: 1 bp = 0.01%. Integer-only fee maths.
  percentageBps   Int             @default(0) @map("percentage_bps")
  minFee          BigInt?         @map("min_fee")
  maxFee          BigInt?         @map("max_fee")
  effectiveFrom   DateTime        @default(now()) @map("effective_from") @db.Timestamptz(3)
  isActive        Boolean         @default(true) @map("is_active")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([transactionType, currency], map: "fee_rules_one_active_idx", where: raw("is_active"))
  @@map("fee_rules")
}

// ─── Payments & integration ──────────────────────────────────────────────────

model PaymentProvider {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// MOCK, later PAYSTACK, FLUTTERWAVE. Secrets live in env vars, never here.
  code      String   @unique
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  payments      Payment[]
  webhookEvents WebhookEvent[]

  @@map("payment_providers")
}

model Payment {
  transactionId     String           @id @map("transaction_id") @db.Uuid
  providerId        String           @map("provider_id") @db.Uuid
  direction         PaymentDirection
  providerReference String?          @map("provider_reference")
  providerStatus    String?          @map("provider_status")
  checkoutUrl       String?          @map("checkout_url")
  bankCode          String?          @map("bank_code")
  bankAccountNumber String?          @map("bank_account_number")
  bankAccountName   String?          @map("bank_account_name")
  metadata          Json             @default("{}")
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  transaction Transaction     @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  provider    PaymentProvider @relation(fields: [providerId], references: [id], onDelete: Restrict)

  @@unique([providerId, providerReference])
  @@map("payments")
}

model WebhookEvent {
  id            String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  providerId    String        @map("provider_id") @db.Uuid
  eventId       String        @map("event_id")
  eventType     String        @map("event_type")
  /// Stored only after signature verification.
  payload       Json
  status        WebhookStatus @default(RECEIVED)
  attempts      Int           @default(0)
  lastError     String?       @map("last_error")
  transactionId String?       @map("transaction_id") @db.Uuid
  receivedAt    DateTime      @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt   DateTime?     @map("processed_at") @db.Timestamptz(3)

  provider    PaymentProvider @relation(fields: [providerId], references: [id], onDelete: Restrict)
  transaction Transaction?    @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  /// The deduplication guarantee: a replayed event fails to insert.
  @@unique([providerId, eventId])
  @@index([transactionId])
  @@map("webhook_events")
}

model IdempotencyKey {
  id             String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId         String            @map("user_id") @db.Uuid
  /// Client's Idempotency-Key header, 8–255 chars (CHECK).
  key            String
  /// SHA-256 of method + path + canonical body.
  requestHash    String            @map("request_hash") @db.Char(64)
  status         IdempotencyStatus @default(IN_PROGRESS)
  responseStatus Int?              @map("response_status")
  responseBody   Json?             @map("response_body")
  transactionId  String?           @map("transaction_id") @db.Uuid
  /// When the current owner claimed the key. Fencing token: a request that has been taken
  /// over after a stale claim sees a different value and aborts before moving money.
  claimedAt      DateTime          @default(now()) @map("claimed_at") @db.Timestamptz(3)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt      DateTime          @map("expires_at") @db.Timestamptz(3)

  user        User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@unique([userId, key])
  @@index([expiresAt])
  @@index([transactionId])
  @@map("idempotency_keys")
}

model OutboxEvent {
  /// Also used as the job ID, so consumers can deduplicate.
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  eventType     String    @map("event_type")
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id") @db.Uuid
  payload       Json
  attempts      Int       @default(0)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(3)

  @@index([createdAt], map: "outbox_events_unpublished_idx", where: raw("published_at IS NULL"))
  @@map("outbox_events")
}

// ─── Platform ────────────────────────────────────────────────────────────────

model Beneficiary {
  id                String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId            String          @map("user_id") @db.Uuid
  type              BeneficiaryType
  recipientWalletId String?         @map("recipient_wallet_id") @db.Uuid
  bankCode          String?         @map("bank_code")
  bankAccountNumber String?         @map("bank_account_number")
  bankAccountName   String?         @map("bank_account_name")
  nickname          String?
  lastUsedAt        DateTime?       @map("last_used_at") @db.Timestamptz(3)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user            User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  recipientWallet Wallet?    @relation(fields: [recipientWalletId], references: [id], onDelete: Restrict)
  transfers       Transfer[]

  @@unique([userId, recipientWalletId], map: "beneficiaries_wallet_unique_idx", where: raw("type = 'FUNDRA_WALLET'"))
  @@unique([userId, bankCode, bankAccountNumber], map: "beneficiaries_bank_unique_idx", where: raw("type = 'BANK_ACCOUNT'"))
  @@index([recipientWalletId])
  @@map("beneficiaries")
}

model Notification {
  id        String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  channel   NotificationChannel
  /// e.g. transfer.received
  type      String
  title     String
  body      String
  /// No secrets, no full account numbers.
  data      Json                @default("{}")
  status    NotificationStatus  @default(PENDING)
  readAt    DateTime?           @map("read_at") @db.Timestamptz(3)
  sentAt    DateTime?           @map("sent_at") @db.Timestamptz(3)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

/// Append-only (trigger, Stage 5 item 4).
model AuditLog {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  actorType    ActorType @map("actor_type")
  actorUserId  String?   @map("actor_user_id") @db.Uuid
  /// e.g. kyc.approved, transfer.created, auth.login_failed
  action       String
  resourceType String?   @map("resource_type")
  resourceId   String?   @map("resource_id")
  ipAddress    String?   @map("ip_address") @db.Inet
  userAgent    String?   @map("user_agent")
  requestId    String?   @map("request_id")
  /// Never passwords, tokens, OTPs or full identity numbers.
  metadata     Json      @default("{}")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([resourceType, resourceId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model SystemSetting {
  key             String   @id
  /// Each key is validated by a Zod schema in code.
  value           Json
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  updatedBy User? @relation(fields: [updatedByUserId], references: [id], onDelete: Restrict)

  @@map("system_settings")
}
